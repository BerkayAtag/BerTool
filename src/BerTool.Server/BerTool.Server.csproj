<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BerTool.Server</RootNamespace>
    <AssemblyName>BerTool.Server</AssemblyName>
    <Version>1.6.0</Version>
    <ApplicationIcon>..\BerTool.TrayAgent\Branding\BerToolBrand.ico</ApplicationIcon>
    <!-- Sunucu tek bir yönetim makinesinde, çoğu zaman kullanıcı oturumunda çalışır.
         Sunucu tipi çöp toplayıcı çekirdek başına büyük yığınlar ayırır ve belleği
         geç bırakır; iş istasyonu (eşzamanlı) toplayıcı bu yük için fazlasıyla hızlıdır
         ve çok daha az bellek kullanır. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BerTool.Shared\BerTool.Shared.csproj" />
  </ItemGroup>

  <Target Name="GenerateBrandIconIfMissing" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\..\BerTool.TrayAgent\Branding\BerToolBrand.ico')">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\BerTool.IconGenerator\BerTool.IconGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\..\BerTool.TrayAgent\Branding\BerToolBrand.ico&quot;" />
  </Target>

</Project>
